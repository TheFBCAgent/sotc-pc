diff --git a/third_party/shadps4/src/video_core/renderer_vulkan/sotc_probe.h b/third_party/shadps4/src/video_core/renderer_vulkan/sotc_probe.h
new file mode 100644
index 0000000..bbb5529
--- /dev/null
+++ b/third_party/shadps4/src/video_core/renderer_vulkan/sotc_probe.h
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// shadow-pc (session 59, TEMPORARY, not committed): where a record's time goes on stage B, by
+// phase, and how many records change cache state (draw-preparation design, docs/NEXT.md).
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <string>
+#include <intrin.h>
+#include <fmt/format.h>
+
+namespace SotcProbe {
+
+enum Kind { Draw, DrawInd, Disp, DispInd, NumKinds };
+inline constexpr const char* KindNames[NumKinds] = {"draw", "draw-ind", "disp", "disp-ind"};
+
+enum Phase {
+    CpuCopy,     // dispatch: SotcCpuCopy(Commit)
+    RenderState, // PrepareRenderState
+    BindBuf,     // BindBuffers (inside BindResources)
+    BindTex,     // BindTextures (inside BindResources)
+    BindRest,    // the rest of BindResources (user data, DMA sync)
+    BeginRt,     // Rasterizer::BeginRendering (render-target lookups) + OnDraw
+    VertexIdx,   // vertex + index buffers (incl. setVertexInputEXT)
+    IndBufs,     // indirect argument/count buffers
+    Barriers,    // FlushBarriers
+    Push,        // pipeline->BindResources (push descriptors / push constants)
+    DynState,    // UpdateDynamicState
+    VkBegin,     // Scheduler::BeginRendering / EndRendering
+    BindDraw,    // BindPipeline + draw/dispatch + hot flush + ResetBindings
+    NumPhases
+};
+inline constexpr const char* PhaseNames[NumPhases] = {
+    "cpucopy", "rstate", "buf",  "tex",     "bindrest", "beginrt",  "vtx",
+    "indbufs", "barr",   "push", "dynstate", "vkbegin", "binddraw"};
+
+// Cache-changing events, counted on B.
+enum Event { Upload, Stream, WriteNote, ImageNew, ImageRefresh, Download, NumEvents };
+inline constexpr const char* EventNames[NumEvents] = {"upload",  "stream", "write-note",
+                                                       "img-new", "img-upload", "download"};
+
+inline std::array<std::array<std::uint64_t, NumPhases>, NumKinds> cyc{};
+inline std::array<std::uint64_t, NumKinds> records{};
+inline std::array<std::uint64_t, NumEvents> events{};             // all events
+inline std::array<std::uint64_t, NumEvents> records_with{};       // records with >= 1 of each
+inline std::uint64_t records_hard = 0; // records with an upload, stream, new image or image upload
+inline std::uint64_t nested_buf = 0, nested_tex = 0;
+inline std::uint64_t last_tsc = 0;
+inline std::chrono::steady_clock::time_point last_time{};
+
+inline void Add(Event e) {
+    ++events[e];
+}
+
+struct Record {
+    Kind kind;
+    std::uint64_t t;
+    std::uint64_t start;
+    std::array<std::uint64_t, NumEvents> ev0;
+    std::uint64_t buf0, tex0;
+    explicit Record(Kind k) : kind(k), t(__rdtsc()), start(t), ev0(events),
+                              buf0(nested_buf), tex0(nested_tex) {}
+    void Lap(Phase p) {
+        const std::uint64_t n = __rdtsc();
+        cyc[kind][p] += n - t;
+        t = n;
+    }
+    // After BindResources: split its time into buffers, textures and the rest.
+    void LapBind() {
+        const std::uint64_t n = __rdtsc();
+        const std::uint64_t buf = nested_buf - buf0, tex = nested_tex - tex0;
+        const std::uint64_t all = n - t;
+        cyc[kind][BindBuf] += buf;
+        cyc[kind][BindTex] += tex;
+        cyc[kind][BindRest] += all > buf + tex ? all - buf - tex : 0;
+        t = n;
+    }
+    ~Record() {
+        Lap(BindDraw);
+        ++records[kind];
+        bool hard = false;
+        for (int e = 0; e < NumEvents; ++e) {
+            if (events[e] != ev0[e]) {
+                ++records_with[e];
+                hard |= e == Upload || e == Stream || e == ImageNew || e == ImageRefresh;
+            }
+        }
+        records_hard += hard;
+    }
+};
+
+struct Nested {
+    std::uint64_t& into;
+    std::uint64_t t = __rdtsc();
+    explicit Nested(std::uint64_t& i) : into(i) {}
+    ~Nested() {
+        into += __rdtsc() - t;
+    }
+};
+
+inline std::string Report() {
+    const auto now = std::chrono::steady_clock::now();
+    const std::uint64_t tsc = __rdtsc();
+    std::string out;
+    if (last_tsc != 0) {
+        const double ns_per_cyc =
+            std::chrono::duration<double, std::nano>(now - last_time).count() /
+            double(tsc - last_tsc);
+        std::uint64_t all_records = 0;
+        double all_ms = 0;
+        for (int k = 0; k < NumKinds; ++k) {
+            all_records += records[k];
+            if (!records[k]) {
+                continue;
+            }
+            double total = 0;
+            std::string phases;
+            for (int p = 0; p < NumPhases; ++p) {
+                const double ns = cyc[k][p] * ns_per_cyc;
+                total += ns;
+                if (cyc[k][p]) {
+                    phases += fmt::format(" {} {:.2f}", PhaseNames[p], ns / 1e3 / records[k]);
+                }
+            }
+            all_ms += total / 1e6;
+            out += fmt::format("\n  probe {}: {} records, {:.2f} us each ({:.0f} ms):{}",
+                               KindNames[k], records[k], total / 1e3 / records[k], total / 1e6,
+                               phases);
+        }
+        std::string ev;
+        for (int e = 0; e < NumEvents; ++e) {
+            ev += fmt::format(" {} {}x in {} records,", EventNames[e], events[e], records_with[e]);
+        }
+        out += fmt::format("\n  probe events:{} records with an upload/stream/new image/image "
+                           "upload: {} of {} ({:.1f}%); records {:.0f} ms in all",
+                           ev, records_hard, all_records,
+                           all_records ? 100.0 * records_hard / all_records : 0.0, all_ms);
+    }
+    last_tsc = tsc;
+    last_time = now;
+    cyc = {};
+    records = {};
+    events = {};
+    records_with = {};
+    records_hard = 0;
+    return out;
+}
+
+} // namespace SotcProbe
